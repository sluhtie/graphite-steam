{
	"name": "Graphite",
	"author": "sluhtie",
	"description": "A clean, minimal and modern Steam. Neutral graphite surfaces, one editable accent color, quiet typography and a single-row header - across the library, menus, settings, friends and the Store & Community pages.",
	"version": "1.2.0",
	"tags": [
		"Minimal",
		"Dark",
		"Modern",
		"Clean",
		"Store",
		"Community"
	],
	"github": {
		"owner": "sluhtie",
		"repo_name": "graphite-steam"
	},
	"header_image": "https://raw.githubusercontent.com/sluhtie/graphite-steam/main/docs/thumbnail.jpg",
	"splash_image": "https://raw.githubusercontent.com/sluhtie/graphite-steam/main/docs/splash.jpg",
	"RootColors": "colors.css",
	"Patches": [
		{
			"MatchRegexString": "^Steam$",
			"TargetCss": "build/main.css"
		},
		{
			"MatchRegexString": "Menu$",
			"TargetCss": "build/menus.css"
		},
		{
			"MatchRegexString": "Supernav$",
			"TargetCss": "build/menus.css"
		},
		{
			"MatchRegexString": ".ModalDialogPopup",
			"TargetCss": "build/dialogs.css"
		},
		{
			"MatchRegexString": ".friendsui-container",
			"TargetCss": "build/friends.css"
		}
	],
	"Conditions": {
		"Font": {
			"description": "Interface font. Inter is loaded from Google Fonts, System uses Segoe UI on Windows.",
			"tab": "Appearance",
			"default": "Inter",
			"values": {
				"Inter": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "build/options/font-inter.css"
					}
				},
				"System": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "build/options/font-system.css"
					}
				},
				"Steam": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "build/options/font-steam.css"
					}
				}
			}
		},
		"Corners": {
			"description": "Corner style of cards, buttons and the content panel.",
			"tab": "Appearance",
			"default": "Rounded",
			"values": {
				"Rounded": {},
				"Sharp": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "build/options/corners-sharp.css"
					}
				}
			}
		},
		"Header": {
			"description": "Single row merges the menu bar and the Store / Library / Community tabs into one compact row.",
			"tab": "Layout",
			"default": "Single row",
			"values": {
				"Single row": {
					"TargetCss": {
						"affects": [
							"^Steam$"
						],
						"src": "build/options/header-single-row.css"
					}
				},
				"Classic": {}
			}
		},
		"Navigation": {
			"description": "Clean: one navigation row. Graphite 2.0 (beta): a new app layout with an icon rail on the left, one search in the title bar and a side navigation for the store and community. View / Friends / Games / Help fold away behind the Steam logo, the profile tab and the tabs' hover dropdowns are removed, and community pages get their own sub-navigation (incl. your profile, inventory, badges ...). Classic keeps Steam's menus.",
			"tab": "Layout",
			"default": "Clean",
			"values": {
				"Clean": {
					"TargetCss": {
						"affects": [
							"^Steam$",
							"^Steam Root Menu$"
						],
						"src": "build/options/nav-clean.css"
					},
					"TargetJs": {
						"affects": [
							"^Steam$",
							"https:\\/\\/store\\.steampowered\\.com\\/.*",
							"https:\\/\\/steamcommunity\\.com\\/.*"
						],
						"src": "build/scripts/nav.js"
					}
				},
				"Graphite 2.0 (beta)": {
					"TargetCss": {
						"affects": [
							"^Steam$",
							"^Steam Root Menu$"
						],
						"src": "build/options/shell.css"
					},
					"TargetJs": {
						"affects": [
							"^Steam$",
							"https:\\/\\/store\\.steampowered\\.com\\/.*",
							"https:\\/\\/steamcommunity\\.com\\/.*"
						],
						"src": "build/scripts/shell.js"
					}
				},
				"Classic": {}
			}
		},
		"Store & community pages": {
			"description": "Also restyle the Store and Community web pages shown inside Steam. Includes a small local script that recolors Valve's newer React pages (wishlist, calendar, news hub, charts).",
			"tab": "Layout",
			"default": "yes",
			"values": {
				"no": {},
				"yes": {
					"TargetCss": {
						"affects": [
							"https:\\/\\/store\\.steampowered\\.com\\/.*",
							"https:\\/\\/steamcommunity\\.com\\/.*",
							"https:\\/\\/help\\.steampowered\\.com\\/.*",
							"https:\\/\\/checkout\\.steampowered\\.com\\/.*"
						],
						"src": "build/options/webkit.css"
					},
					"TargetJs": {
						"affects": [
							"https:\\/\\/store\\.steampowered\\.com\\/.*",
							"https:\\/\\/steamcommunity\\.com\\/.*",
							"https:\\/\\/help\\.steampowered\\.com\\/.*",
							"https:\\/\\/checkout\\.steampowered\\.com\\/.*"
						],
						"src": "build/scripts/web-recolor.js"
					}
				}
			}
		},
		"Hide URL bar": {
			"description": "Hide the address bar above store and community pages (the Store / Community tabs and the page navigation already cover it).",
			"tab": "Layout",
			"default": "yes",
			"values": {
				"no": {},
				"yes": {
					"TargetCss": {
						"affects": [
							"^Steam$"
						],
						"src": "build/options/hide-url-bar.css"
					}
				}
			}
		},
		"Hide What's New": {
			"description": "Hide the \"What's New\" event row on the library home page.",
			"tab": "Layout",
			"default": "no",
			"values": {
				"no": {},
				"yes": {
					"TargetCss": {
						"affects": [
							"^Steam$"
						],
						"src": "build/options/hide-whats-new.css"
					}
				}
			}
		}
	}
}
